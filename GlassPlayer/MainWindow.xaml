<Window x:Class="GlassPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:GlassPlayer"
        Title="LiquidCloud" Icon="LiquidCloud.ico" Width="1120" Height="760" MinWidth="920" MinHeight="620"
        WindowStyle="None" Background="Transparent" Foreground="White"
        FontFamily="Segoe UI Variable Display, Segoe UI" TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.7">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.8">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <!-- theme values; replaced at runtime by ApplyLook() -->
        <SolidColorBrush x:Key="AccentBrush" Color="#5E5CE6"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#595E5CE6"/>
        <SolidColorBrush x:Key="OnAccentBrush" Color="White"/>
        <SolidColorBrush x:Key="SheetBrush" Color="#E81E1E28"/>
        <SolidColorBrush x:Key="Blob1Brush" Color="#405E5CE6"/>
        <SolidColorBrush x:Key="Blob2Brush" Color="#40FF375F"/>
        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2CFFFFFF" Offset="0"/>
            <GradientStop Color="#0AFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8CFFFFFF" Offset="0"/>
            <GradientStop Color="#14FFFFFF" Offset=".5"/>
            <GradientStop Color="#4DFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <CornerRadius x:Key="GlassRadius">28</CornerRadius>
        <local:ArtConverter x:Key="Art"/>

        <Style x:Key="Glass" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource GlassRadius}"/>
            <Setter Property="Background" Value="{DynamicResource GlassFill}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity=".28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Round" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="999" Background="Transparent" RenderTransformOrigin=".5,.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="sc"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Light" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Width="13" Height="13" Fill="{TemplateBinding Background}" Margin="0,0,8,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="14" Padding="16,6" Background="#00FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color" To="#47FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="b" Storyboard.TargetProperty="Background.Color" To="#00FFFFFF" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Search" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="16" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="12,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Opacity=".6" Margin="0,2,10,0"/>
                                <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Opacity=".45" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" CornerRadius="16" Padding="8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#17FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Rail" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" Height="5" CornerRadius="3" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value=".55"/>
            <Setter Property="Margin" Value="0,18,0,4"/>
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14" Padding="16,7" Background="#2EFFFFFF">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#47FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Seek" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="5" CornerRadius="3" Background="#38FFFFFF"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Rail}" Background="{DynamicResource AccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity=".4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Rail}" Background="Transparent"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="48" Height="29" Background="Transparent">
                            <Border CornerRadius="15" Background="#3DFFFFFF"/>
                            <Border x:Name="on" CornerRadius="15" Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <Ellipse Width="23" Height="23" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="knob"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity=".35"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="X" To="19" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ===== background layers ===== -->
        <Grid x:Name="Ambient" IsHitTestVisible="False">
            <Ellipse Width="780" Height="780" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-320,-360,0,0" Fill="{DynamicResource Blob1Brush}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob1T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="740" Height="740" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-340" Fill="{DynamicResource Blob2Brush}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob2T"/></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect><BlurEffect x:Name="BgBlurFx" Radius="0" KernelType="Gaussian"/></Image.Effect>
        </Image>
        <Image x:Name="Glow" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False">
            <Image.Effect><BlurEffect Radius="110"/></Image.Effect>
        </Image>
        <Border x:Name="BgDim" Background="Black" Opacity="0" IsHitTestVisible="False"/>
        <local:ParticleLayer x:Name="Particles"/>

        <!-- ===== main UI ===== -->
        <Grid x:Name="Root" Opacity="0" RenderTransformOrigin=".5,.5">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.RenderTransform>
                <ScaleTransform x:Name="RootScale" ScaleX=".95" ScaleY=".95"/>
            </Grid.RenderTransform>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Light}" Background="#FF5F57" Click="Close_Click"/>
                <Button Style="{StaticResource Light}" Background="#FEBC2E" Click="Min_Click"/>
                <Button Style="{StaticResource Light}" Background="#28C840" Click="Max_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BrowseBtn" Style="{StaticResource Action}" Content="Browse SoundCloud" Margin="0,0,10,0" Click="Browse_Click"/>
                <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="15" Content="&#xE713;" Click="Settings_Click"/>
            </StackPanel>
            <Border CornerRadius="18" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="3" HorizontalAlignment="Center" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="SoundCloudBtn" Style="{StaticResource Pill}" Content="SoundCloud" Tag="SoundCloud" Checked="Provider_Checked"/>
                    <RadioButton x:Name="YouTubeBtn" Style="{StaticResource Pill}" Content="YouTube Music" Tag="YouTube Music" Checked="Provider_Checked"/>
                    <RadioButton x:Name="SpotifyBtn" Style="{StaticResource Pill}" Content="Spotify" Tag="Spotify" Checked="Provider_Checked"/>
                </StackPanel>
            </Border>

            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- left: search list / SoundCloud browser -->
                <Border x:Name="LeftPanel" Style="{StaticResource Glass}" Padding="16" Width="350">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="TopArea">
                        <Grid x:Name="SearchRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Tag="Songs, artists" KeyDown="Search_KeyDown"/>
                            <Button Grid.Column="1" Style="{StaticResource Action}" Content="Import" Margin="8,0,0,0" Click="Import_Click"/>
                        </Grid>
                        <!-- your SoundCloud: shown while the SoundCloud tab is selected -->
                        <Grid x:Name="ScChips" Margin="0,0,0,8">
                            <Border x:Name="ScTabs" CornerRadius="18" Background="#14FFFFFF" Padding="3" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Pill}" GroupName="sc" Content="♥ Likes" Tag="Likes" Click="ScTab_Click"/>
                                    <RadioButton Style="{StaticResource Pill}" GroupName="sc" Content="Feed" Tag="Feed" Click="ScTab_Click"/>
                                    <RadioButton Style="{StaticResource Pill}" GroupName="sc" Content="Playlists" Tag="Playlists" Click="ScTab_Click"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="ScSignIn" Style="{StaticResource Action}" Content="Sign in to SoundCloud" HorizontalAlignment="Left" Click="ScSignIn_Click"/>
                        </Grid>
                        </StackPanel>
                        <ListBox x:Name="List" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="List_PreviewMouseWheel" SelectionChanged="List_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="46" Height="46" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                                            <Grid>
                                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Opacity=".7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Border CornerRadius="11">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding Art, Converter={StaticResource Art}}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Artist}" FontSize="12" Opacity=".6" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Opacity=".5" VerticalAlignment="Center" Margin="10,0,2,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid x:Name="BrowseView" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE72B;" ToolTip="Back" Click="ScBack_Click"/>
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE72A;" ToolTip="Forward" Click="ScForward_Click"/>
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE72C;" ToolTip="Reload" Click="ScReload_Click"/>
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE80F;" ToolTip="Home" Click="ScHome_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ScUrl" Grid.Column="1" Opacity=".55" FontSize="12" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource Action}" Content="▶  Play this page here" Click="ScPlayPage_Click"/>
                            </Grid>
                            <Border x:Name="WebHost" Grid.Row="1" CornerRadius="16" Background="#14000000"/>
                        </Grid>

                        <TextBlock x:Name="Status" Grid.Row="2" Text="Search for a song or artist." Opacity=".6" TextWrapping="Wrap" Margin="4,8,4,0"/>
                    </Grid>
                </Border>

                <!-- right: now playing -->
                <Border Grid.Column="2" Style="{StaticResource Glass}" Padding="32,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="MainArea" ClipToBounds="False">
                            <StackPanel x:Name="NormalView" VerticalAlignment="Center" MaxWidth="460">
                                <Border x:Name="ArtSpacer" Width="280" Height="280" Margin="0,0,0,22"/>
                                <TextBlock x:Name="TitleText" Text="Nothing playing" FontSize="26" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistText" Text="Pick a track from the list" FontSize="16" Opacity=".6" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,14"/>
                                <StackPanel x:Name="LyricPreview">
                                    <TextBlock x:Name="LyrPrev" FontSize="13" Opacity=".35" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="LyrCur" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3"/>
                                    <TextBlock x:Name="LyrNext" FontSize="13" Opacity=".35" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button Style="{StaticResource Action}" Content="Lyrics  ⤢" HorizontalAlignment="Center" Margin="0,10,0,0" Click="ExpandLyrics_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False">
                                <Grid.RenderTransform><TranslateTransform x:Name="ExpandedT" Y="24"/></Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="76"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="92,0,52,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExpTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ExpArtist" FontSize="14" Opacity=".6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource Round}" Width="36" Height="36" FontSize="13" Content="&#xE73F;" ToolTip="Back to cover" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExpandLyrics_Click"/>
                                <ScrollViewer x:Name="LyricsScroll" Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Hidden">
                                    <ScrollViewer.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="Black" Offset=".08"/>
                                            <GradientStop Color="Black" Offset=".88"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ScrollViewer.OpacityMask>
                                    <StackPanel x:Name="LyricsStack" Margin="4,40,4,200"/>
                                </ScrollViewer>
                            </Grid>

                            <Canvas x:Name="ArtLayer" IsHitTestVisible="False">
                                <Border x:Name="ArtBox" Width="280" Height="280" CornerRadius="30" RenderTransformOrigin=".5,.5" Background="{DynamicResource AccentSoftBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="50" ShadowDepth="14" Direction="270" Opacity=".4"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ArtScale" ScaleX=".88" ScaleY=".88"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="64" Opacity=".6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border CornerRadius="{Binding CornerRadius, ElementName=ArtBox}">
                                            <Border.Background>
                                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Grid>

                        <StackPanel Grid.Row="1" MaxWidth="460" Margin="0,16,0,0">
                            <Slider x:Name="Seek" Style="{StaticResource Seek}" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" ValueChanged="Seek_ValueChanged"/>
                            <Grid Margin="0,2,0,10">
                                <TextBlock x:Name="Cur" Text="0:00" FontSize="12" Opacity=".6"/>
                                <TextBlock x:Name="Dur" Text="0:00" FontSize="12" Opacity=".6" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource Round}" Width="52" Height="52" FontSize="20" Content="&#xE892;" Click="Prev_Click"/>
                                <Grid Margin="16,0" Width="68" Height="68">
                                    <Ellipse x:Name="PlayRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin=".5,.5">
                                        <Ellipse.RenderTransform><ScaleTransform x:Name="PlayRingScale"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Border CornerRadius="34" Background="{DynamicResource AccentBrush}">
                                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity=".35"/></Border.Effect>
                                        <Button x:Name="PlayBtn" Style="{StaticResource Round}" Foreground="{DynamicResource OnAccentBrush}" FontSize="26" Content="&#xE768;" Click="PlayPause_Click"/>
                                    </Border>
                                </Grid>
                                <Button Style="{StaticResource Round}" Width="52" Height="52" FontSize="20" Content="&#xE893;" Click="Next_Click"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Opacity=".6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Slider x:Name="Volume" Style="{StaticResource Seek}" IsMoveToPointEnabled="True" Width="140" Minimum="0" Maximum="1" Value=".8" ValueChanged="Volume_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== settings ===== -->
        <Grid x:Name="Overlay" Margin="0,48,0,0" Visibility="Collapsed">
            <Border x:Name="Dim" Background="#59000000" Opacity="0" MouseLeftButtonDown="Dim_Click"/>
            <Border x:Name="Sheet" Style="{StaticResource Glass}" Background="{DynamicResource SheetBrush}" Margin="16,0,16,16" Padding="32,26" Opacity="0" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SheetScale" ScaleX=".94" ScaleY=".94"/>
                </Border.RenderTransform>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel MaxWidth="620">
                        <Grid>
                            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="12" Content="&#xE711;" HorizontalAlignment="Right" Click="CloseSettings_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="Accounts"/>
                        <Border CornerRadius="18" Background="#14FFFFFF" Padding="14" Margin="0,4,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="48" Height="48">
                                    <Border CornerRadius="24" Background="#26FFFFFF"/>
                                    <Border CornerRadius="24">
                                        <Border.Background>
                                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock x:Name="AvatarInitial" Text="S" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpotifyName" Text="Spotify" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SpotifyDetail" Text="" FontSize="12" Opacity=".6" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="SpotifyAction" Grid.Column="2" Style="{StaticResource Action}" Content="Connect" VerticalAlignment="Center" Click="SpotifyAction_Click"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="18" Background="#14FFFFFF" Padding="14">
                            <StackPanel>
                                <TextBlock Text="YouTube Music and SoundCloud" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SoundCloudDetail" FontSize="12" Opacity=".6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SettingsHost"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== import ===== -->
        <Grid x:Name="ImportOverlay" Margin="0,48,0,0" Visibility="Collapsed">
            <Border Background="#59000000" MouseLeftButtonDown="ImportDim_Click"/>
            <Border x:Name="ImportCard" Style="{StaticResource Glass}" Background="{DynamicResource SheetBrush}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24" Opacity="0" RenderTransformOrigin=".5,.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ImportScale" ScaleX=".94" ScaleY=".94"/>
                </Border.RenderTransform>
                <StackPanel>
                    <TextBlock Text="Import" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Paste a playlist or song link from YouTube, YouTube Music, SoundCloud or Spotify, or pick audio files or a folder from this PC. You can also drop files onto the window." FontSize="13" Opacity=".6" TextWrapping="Wrap" Margin="0,6,0,14"/>
                    <TextBox x:Name="ImportBox" Style="{StaticResource Search}" Tag="Paste a link" KeyDown="Import_KeyDown"/>
                    <Grid Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Action}" Content="Choose files…" Click="ImportFiles_Click"/>
                            <Button Style="{StaticResource Action}" Content="Choose folder…" Margin="8,0,0,0" Click="ImportFolder_Click"/>
                        </StackPanel>
                        <Button x:Name="ImportGo" Style="{StaticResource Action}" Content="Import link" HorizontalAlignment="Right" Click="ImportGo_Click"/>
                    </Grid>
                    <TextBlock x:Name="ImportStatus" FontSize="12" Opacity=".75" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- hidden Spotify Web Playback device (only started after you connect Spotify) -->
        <wv2:WebView2 x:Name="Web" Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
    </Grid>
</Window>
