<Window x:Class="LiquidCloud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:LiquidCloud"
        Title="LiquidCloud" Icon="LiquidCloud.ico" Width="1360" Height="840" MinWidth="1040" MinHeight="660"
        WindowStyle="None" Background="Transparent" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>


    <Grid x:Name="WindowRoot">
        <!-- ===== background layers ===== -->
        <Border x:Name="BgBase" Background="{DynamicResource BgBaseBrush}" IsHitTestVisible="False"/>
        <Grid x:Name="Ambient" IsHitTestVisible="False">
            <Grid.CacheMode><BitmapCache RenderAtScale="0.5"/></Grid.CacheMode>
            <Ellipse Width="820" Height="820" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-320,-380,0,0" Fill="{DynamicResource Blob1Brush}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob1T"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-340" Fill="{DynamicResource Blob2Brush}">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Blob2T"/></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>
        <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect><BlurEffect x:Name="BgBlurFx" Radius="0" KernelType="Gaussian"/></Image.Effect>
        </Image>
        <!-- pre-blurred (SoftBlur), no live effect: live blur on a window-sized layer left stale rectangles -->
        <Image x:Name="Glow" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="Linear"/>
        <Border x:Name="BgDim" Background="Black" Opacity="0" IsHitTestVisible="False"/>
        <local:ParticleLayer x:Name="Particles"/>

        <!-- ===== app ===== -->
        <Grid x:Name="Root" Opacity="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid x:Name="TitleBar">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Light}" Background="#FF5F57" ToolTip="{DynamicResource T_Close}" AutomationProperties.Name="{DynamicResource T_Close}" Click="Close_Click"/>
                    <Button Style="{StaticResource Light}" Background="#FEBC2E" ToolTip="{DynamicResource T_Minimize}" AutomationProperties.Name="{DynamicResource T_Minimize}" Click="Min_Click"/>
                    <Button Style="{StaticResource Light}" Background="#28C840" ToolTip="{DynamicResource T_Maximize}" AutomationProperties.Name="{DynamicResource T_Maximize}" Click="Max_Click"/>
                    <Button x:Name="BackBtn" Style="{StaticResource Round}" Width="32" Height="32" FontSize="12" Content="&#xE72B;" Margin="14,0,0,0" ToolTip="{DynamicResource T_Back}" AutomationProperties.Name="{DynamicResource T_Back}" Click="Back_Click"/>
                    <Button x:Name="ForwardBtn" Style="{StaticResource Round}" Width="32" Height="32" FontSize="12" Content="&#xE72A;" ToolTip="{DynamicResource T_Forward}" AutomationProperties.Name="{DynamicResource T_Forward}" Click="Forward_Click" IsEnabled="False"/>
                </StackPanel>
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Search}" Tag="{DynamicResource T_SearchHint}" AutomationProperties.Name="{DynamicResource T_SearchHint}"
                             KeyDown="Search_KeyDown" TextChanged="Search_TextChanged" GotKeyboardFocus="Search_Focus" LostKeyboardFocus="Search_LostFocus"/>
                    <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="6" Margin="8" Width="444" Effect="{DynamicResource SoftShadow}">
                            <StackPanel x:Name="SuggestHost"/>
                        </Border>
                    </Popup>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="14" Content="&#xE8A7;" ToolTip="{DynamicResource T_MiniPlayer}" AutomationProperties.Name="{DynamicResource T_MiniPlayer}" Click="Mini_Click"/>
                    <Button x:Name="FullBtn" Style="{StaticResource Round}" Width="34" Height="34" FontSize="14" Content="&#xE740;" ToolTip="{DynamicResource T_FullPlayer}" AutomationProperties.Name="{DynamicResource T_FullPlayer}" Click="Full_Click"/>
                    <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="15" Content="&#xE713;" ToolTip="{DynamicResource T_Settings}" AutomationProperties.Name="{DynamicResource T_Settings}" Click="Settings_Click"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="Body" Grid.Row="1" Margin="14,0,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SideCol" Width="236"/>
                    <ColumnDefinition x:Name="GapCol1" Width="12"/>
                    <ColumnDefinition x:Name="CenterCol" MinWidth="0"/>
                    <ColumnDefinition x:Name="GapCol2" Width="12"/>
                    <ColumnDefinition x:Name="NowCol" Width="380"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="SideShadow" Style="{StaticResource PanelShadow}"/>
                <Border x:Name="CenterShadow" Grid.Column="2" Style="{StaticResource PanelShadow}"/>
                <Border x:Name="NowShadow" Grid.Column="4" Style="{StaticResource PanelShadow}"/>

                <!-- sidebar -->
                <Border x:Name="Sidebar" Style="{StaticResource Glass}" Padding="10,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,14">
                            <Image Source="icon.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="LiquidCloud" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="NavHost" Grid.Row="1">
                            <RadioButton x:Name="NavHome" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE80F;" Content="{DynamicResource T_Home}" Click="Nav_Click" CommandParameter="home"/>
                            <RadioButton x:Name="NavDiscover" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE721;" Content="{DynamicResource T_Discover}" Click="Nav_Click" CommandParameter="discover"/>
                            <RadioButton x:Name="NavLibrary" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE8F1;" Content="{DynamicResource T_Library}" Click="Nav_Click" CommandParameter="library"/>
                            <RadioButton x:Name="NavWeb" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE774;" Content="{DynamicResource T_SoundCloudWeb}" Click="Nav_Click" CommandParameter="web"/>
                            <RadioButton x:Name="NavThemes" Style="{StaticResource Nav}" GroupName="nav" Tag="&#xE790;" Content="{DynamicResource T_Themes}" Click="Nav_Click" CommandParameter="themes"/>
                        </StackPanel>
                        <Grid Grid.Row="2" Margin="12,18,4,6">
                            <TextBlock Text="{DynamicResource T_Playlists}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource Round}" Width="26" Height="26" FontSize="11" Content="&#xE710;" HorizontalAlignment="Right" ToolTip="{DynamicResource T_NewPlaylist}" AutomationProperties.Name="{DynamicResource T_NewPlaylist}" Click="NewPlaylist_Click"/>
                        </Grid>
                        <ScrollViewer x:Name="SidebarScroll" Grid.Row="3" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="SidebarPlaylists"/>
                        </ScrollViewer>
                        <Border x:Name="AccountBox" Grid.Row="4" CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource HoverBrush}" Padding="10" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="AccountBox_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="34" Height="34">
                                    <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                                    <TextBlock x:Name="AccountInitial" Text="&#xE77B;" FontFamily="{StaticResource Icons}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse>
                                        <Ellipse.Fill><ImageBrush x:Name="AccountAvatar" Stretch="UniformToFill"/></Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" Text="{DynamicResource T_SignInSc}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="AccountHint" Text="{DynamicResource T_SignInScHint}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- pages -->
                <Border x:Name="CenterPanel" Grid.Column="2" Style="{StaticResource Glass}" ClipToBounds="True">
                    <Grid>
                        <Grid x:Name="PageHost" ClipToBounds="True"/>
                        <Grid x:Name="BrowseView" Visibility="Collapsed" Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE72B;" ToolTip="{DynamicResource T_WebBack}" AutomationProperties.Name="{DynamicResource T_WebBack}" Click="ScBack_Click"/>
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE72A;" ToolTip="{DynamicResource T_WebForward}" AutomationProperties.Name="{DynamicResource T_WebForward}" Click="ScForward_Click"/>
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE72C;" ToolTip="{DynamicResource T_Reload}" AutomationProperties.Name="{DynamicResource T_Reload}" Click="ScReload_Click"/>
                                    <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="13" Content="&#xE80F;" ToolTip="{DynamicResource T_Home}" AutomationProperties.Name="{DynamicResource T_Home}" Click="ScHome_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ScUrl" Grid.Column="1" Foreground="{DynamicResource TextDimBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Style="{StaticResource Action}" Content="{DynamicResource T_PlayThisPage}" Click="ScPlayPage_Click"/>
                            </Grid>
                            <Border x:Name="WebHost" Grid.Row="1" CornerRadius="{DynamicResource CardRadius}" Background="#14000000"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- player -->
                <Border x:Name="NowPanel" Grid.Column="4" Style="{StaticResource Glass}" Padding="26,18,26,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border CornerRadius="{DynamicResource ControlRadius}" Background="{DynamicResource FieldBrush}" Padding="3" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabNow" Style="{StaticResource Pill}" GroupName="ptab" Content="{DynamicResource T_TabPlaying}" IsChecked="True" Click="PlayerTab_Click" CommandParameter="now"/>
                                <RadioButton x:Name="TabLyrics" Style="{StaticResource Pill}" GroupName="ptab" Content="{DynamicResource T_TabLyrics}" Click="PlayerTab_Click" CommandParameter="lyrics"/>
                                <RadioButton x:Name="TabQueue" Style="{StaticResource Pill}" GroupName="ptab" Content="{DynamicResource T_TabQueue}" Click="PlayerTab_Click" CommandParameter="queue"/>
                            </StackPanel>
                        </Border>

                        <Grid x:Name="MainArea" Grid.Row="1" Margin="0,14,0,0">
                            <StackPanel x:Name="NormalView" VerticalAlignment="Center">
                                <Border x:Name="ArtSpacer" Width="280" Height="280" Margin="0,0,0,20"/>
                                <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                                <TextBlock x:Name="ArtistText" Text="{Binding Artist}" FontSize="15" Foreground="{DynamicResource TextDimBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Cursor="Hand" MouseLeftButtonUp="Artist_Click"/>
                                <TextBlock x:Name="MetaText" Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                <local:LevelBars x:Name="Bars" Height="26" Margin="40,12,40,4"/>
                                <StackPanel x:Name="LyricPreview" Margin="0,4,0,0" Cursor="Hand" MouseLeftButtonUp="LyricPreview_Click">
                                    <TextBlock x:Name="LyrPrev" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="LyrCur" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                                    <TextBlock x:Name="LyrNext" FontSize="12" Foreground="{DynamicResource TextFaintBrush}" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False">
                                <Grid.RenderTransform><TranslateTransform x:Name="ExpandedT" Y="24"/></Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="76"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="90,0,44,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExpTitle" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="ExpArtist" Text="{Binding Artist}" FontSize="13" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="12" Content="&#xE73F;" ToolTip="{DynamicResource T_BackToCover}" AutomationProperties.Name="{DynamicResource T_BackToCover}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CollapsePlayer_Click"/>
                                <ScrollViewer x:Name="LyricsScroll" Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Hidden">
                                    <ScrollViewer.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="Black" Offset=".08"/>
                                            <GradientStop Color="Black" Offset=".88"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ScrollViewer.OpacityMask>
                                    <StackPanel x:Name="LyricsStack" Margin="4,40,4,200"/>
                                </ScrollViewer>
                                <Grid x:Name="QueueView" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="4,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource T_PlayingFrom}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}"/>
                                            <TextBlock x:Name="QueueName" Text="{Binding QueueName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,90,0"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource Action}" Content="{DynamicResource T_Clear}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="{DynamicResource T_ClearQueueTip}" Click="ClearQueue_Click"/>
                                    </Grid>
                                    <ListBox x:Name="List" Grid.Row="1" ItemsSource="{Binding QueueItems}" AutomationProperties.Name="{DynamicResource T_UpNext}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" AllowDrop="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                             ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                             PreviewMouseWheel="List_PreviewMouseWheel" SelectionChanged="List_SelectionChanged"
                                             PreviewMouseLeftButtonDown="Queue_MouseDown" PreviewMouseMove="Queue_MouseMove" Drop="Queue_Drop" MouseRightButtonUp="Queue_RightClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                                                        <Border CornerRadius="9" local:ImageLoader.Size="80" local:ImageLoader.Url="{Binding Art}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>

                            <Canvas x:Name="ArtLayer" IsHitTestVisible="False">
                                <Border x:Name="ArtBox" Width="280" Height="280" CornerRadius="28" RenderTransformOrigin=".5,.5" Background="{DynamicResource AccentSoftBrush}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="50" ShadowDepth="14" Direction="270" Opacity=".45"/>
                                    </Border.Effect>
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ArtScale" ScaleX=".9" ScaleY=".9"/>
                                    </Border.RenderTransform>
                                    <Grid>
                                        <Image Source="icon.png" Width="96" Height="96" Opacity=".55" x:Name="ArtPlaceholder" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border CornerRadius="{Binding CornerRadius, ElementName=ArtBox}">
                                            <Border.Background>
                                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="{Binding CornerRadius, ElementName=ArtBox}" Background="{DynamicResource GlassSheen}" BorderBrush="#33FFFFFF" BorderThickness="1"/>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Grid>

                        <StackPanel x:Name="Controls" Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock x:Name="Status" Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Slider x:Name="Seek" Style="{StaticResource Seek}" IsMoveToPointEnabled="True" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource T_Position}" SmallChange="5" LargeChange="10" Focusable="True"/>
                            <Grid Margin="0,2,0,8">
                                <TextBlock x:Name="Cur" Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource TextDimBrush}"/>
                                <TextBlock x:Name="Dur" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource TextDimBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="ShuffleBtn" Style="{StaticResource ModeButton}" Tag="{Binding Shuffle}" Width="40" Height="40" FontSize="15" Content="&#xE8B1;" ToolTip="{DynamicResource T_Shuffle}" AutomationProperties.Name="{DynamicResource T_Shuffle}" Command="{Binding ShuffleCommand}"/>
                                    <Button Style="{StaticResource Round}" Width="48" Height="48" FontSize="19" Content="&#xE892;" ToolTip="{DynamicResource T_Previous}" AutomationProperties.Name="{DynamicResource T_Previous}" Command="{Binding PreviousCommand}" Margin="6,0,0,0"/>
                                    <Grid Margin="12,0" Width="64" Height="64">
                                        <Ellipse x:Name="PlayRing" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin=".5,.5">
                                            <Ellipse.RenderTransform><ScaleTransform x:Name="PlayRingScale"/></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Border CornerRadius="32" Background="{DynamicResource AccentBrush}" Effect="{DynamicResource SoftShadow}">
                                            <Button x:Name="PlayBtn" Style="{StaticResource Round}" Foreground="{DynamicResource OnAccentBrush}" FontSize="24" Content="{Binding PlayGlyph}" ToolTip="{DynamicResource T_PlayPause}" AutomationProperties.Name="{DynamicResource T_PlayPause}" Command="{Binding PlayPauseCommand}"/>
                                        </Border>
                                    </Grid>
                                    <Button Style="{StaticResource Round}" Width="48" Height="48" FontSize="19" Content="&#xE893;" ToolTip="{DynamicResource T_Next}" AutomationProperties.Name="{DynamicResource T_Next}" Command="{Binding NextCommand}" Margin="0,0,6,0"/>
                                    <Grid>
                                        <Button x:Name="RepeatBtn" Style="{StaticResource ModeButton}" Tag="{Binding RepeatOn}" Width="40" Height="40" FontSize="15" Content="{Binding RepeatGlyph}" ToolTip="{Binding RepeatTip}" AutomationProperties.Name="{Binding RepeatTip}" Command="{Binding RepeatCommand}"/>
                                        <TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0" Visibility="{Binding RepeatOne, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LikeBtn" Style="{StaticResource ModeButton}" Tag="{Binding IsFavorite}" Width="36" Height="36" FontSize="15" Content="{Binding LikeGlyph}" ToolTip="{Binding LikeTip}" AutomationProperties.Name="{Binding LikeTip}" Command="{Binding LikeCommand}"/>
                                <Button x:Name="MuteBtn" Grid.Column="1" Style="{StaticResource Round}" Width="36" Height="36" FontSize="15" Content="{Binding VolumeGlyph}" ToolTip="{DynamicResource T_Mute}" AutomationProperties.Name="{DynamicResource T_Mute}" Command="{Binding MuteCommand}" Margin="4,0,8,0"/>
                                <Slider x:Name="Volume" Grid.Column="2" Style="{StaticResource Seek}" IsMoveToPointEnabled="True" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" SmallChange=".05" LargeChange=".1" AutomationProperties.Name="{DynamicResource T_Volume}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Style="{StaticResource Round}" Width="36" Height="36" FontSize="15" Content="&#xE710;" ToolTip="{DynamicResource T_AddToPlaylist}" AutomationProperties.Name="{DynamicResource T_AddToPlaylist}" Click="AddCurrentToPlaylist_Click" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- mini player -->
            <Grid x:Name="MiniBar" Grid.RowSpan="2" Visibility="Collapsed" Margin="10">
                <Border Style="{StaticResource Glass}"/>
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="64" Height="64">
                        <Border CornerRadius="14" Background="{DynamicResource AccentSoftBrush}"/>
                        <Image Source="icon.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" Opacity=".85"/>
                        <Border CornerRadius="14">
                            <Border.Background><ImageBrush x:Name="MiniArt" Stretch="UniformToFill"/></Border.Background>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="MiniTitle" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MiniArtist" Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="MiniProgress" Value="{Binding Progress, Mode=OneWay}" Height="3" Margin="0,8,0,0" Maximum="1" Background="{DynamicResource LineBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="14" Content="&#xE892;" AutomationProperties.Name="{DynamicResource T_Previous}" Command="{Binding PreviousCommand}"/>
                        <Button x:Name="MiniPlay" Style="{StaticResource Round}" Width="40" Height="40" FontSize="18" Content="{Binding PlayGlyph}" AutomationProperties.Name="{DynamicResource T_PlayPause}" Command="{Binding PlayPauseCommand}"/>
                        <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="14" Content="&#xE893;" AutomationProperties.Name="{DynamicResource T_Next}" Command="{Binding NextCommand}"/>
                        <Button Style="{StaticResource Round}" Width="34" Height="34" FontSize="13" Content="&#xE740;" ToolTip="{DynamicResource T_BackToWindow}" AutomationProperties.Name="{DynamicResource T_BackToWindow}" Click="Mini_Click" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== settings sheet ===== -->
        <Grid x:Name="Overlay" Margin="0,52,0,0" Visibility="Collapsed">
            <Border x:Name="Dim" Background="#66000000" Opacity="0" MouseLeftButtonDown="Dim_Click"/>
            <Border x:Name="Sheet" Style="{StaticResource Glass}" Background="{DynamicResource SheetBrush}" Margin="14,0,14,14" Padding="34,26" Opacity="0" RenderTransformOrigin=".5,.5" MaxWidth="820">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SheetScale" ScaleX=".96" ScaleY=".96"/>
                </Border.RenderTransform>
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Hidden">
                    <StackPanel MaxWidth="640">
                        <Grid>
                            <TextBlock Text="{DynamicResource T_Settings}" FontSize="26" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"/>
                            <Button Style="{StaticResource Round}" Width="32" Height="32" FontSize="12" Content="&#xE711;" HorizontalAlignment="Right" ToolTip="{DynamicResource T_CloseSettings}" AutomationProperties.Name="{DynamicResource T_CloseSettings}" Click="CloseSettings_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Section}" Text="{DynamicResource T_Accounts}"/>
                        <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource HoverBrush}" Padding="14" Margin="0,4,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="46" Height="46">
                                    <Border CornerRadius="23" Background="{DynamicResource PressBrush}"/>
                                    <Border CornerRadius="23">
                                        <Border.Background><ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/></Border.Background>
                                    </Border>
                                    <TextBlock x:Name="AvatarInitial" Text="S" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SpotifyName" Text="Spotify" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SpotifyDetail" FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="SpotifyAction" Grid.Column="2" Style="{StaticResource Action}" Content="{DynamicResource T_Connect}" VerticalAlignment="Center" Click="SpotifyAction_Click"/>
                            </Grid>
                        </Border>
                        <Border CornerRadius="{DynamicResource CardRadius}" Background="{DynamicResource HoverBrush}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource T_ScAndYt}" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SoundCloudDetail" FontSize="12" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="SettingsHost"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== modal dialogs ===== -->
        <Grid x:Name="ModalOverlay" Visibility="Collapsed">
            <Border x:Name="ModalDim" Background="#73000000" Opacity="0" MouseLeftButtonDown="ModalDim_Click"/>
            <Border x:Name="ModalCard" Style="{StaticResource Glass}" Background="{DynamicResource SheetBrush}" Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26,22">
                <StackPanel>
                    <TextBlock x:Name="ModalTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <ContentControl x:Name="ModalBody" Margin="0,12,0,0"/>
                    <StackPanel x:Name="ModalButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== toasts ===== -->
        <StackPanel x:Name="ToastHost" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" IsHitTestVisible="False"/>

        <!-- ===== welcome intro ===== -->
        <Grid x:Name="Welcome" Visibility="Collapsed" Background="#03060F" MouseLeftButtonDown="Welcome_Click" Cursor="Hand">
            <Grid x:Name="WelcomeLights" IsHitTestVisible="False">
                <Ellipse Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-420,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#802E6BFF" Offset="0"/>
                            <GradientStop Color="#002E6BFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="WLight1"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="800" Height="800" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-380">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#7038D1FF" Offset="0"/>
                            <GradientStop Color="#0038D1FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="WLight2"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="420" Height="420" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="320,-260,0,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#40E6F7FF" Offset="0"/>
                            <GradientStop Color="#00E6F7FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><TranslateTransform x:Name="WLight3"/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <Border x:Name="WelcomeGlass" Width="560" Padding="44,40" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="34" BorderThickness="1" Opacity="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#26CFE6FF" Offset="0"/>
                        <GradientStop Color="#08FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#99FFFFFF" Offset="0"/>
                        <GradientStop Color="#10FFFFFF" Offset=".5"/>
                        <GradientStop Color="#4DFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <StackPanel>
                    <Image Source="icon.png" Width="74" Height="74" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" x:Name="WelcomeIcon" Opacity="0"/>
                    <TextBlock x:Name="WelcomeBrand" Text="LiquidCloud." FontSize="46" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White" Margin="0,18,0,0" Opacity="0"/>
                    <TextBlock x:Name="WelcomeHi" FontSize="26" Foreground="White" Margin="0,22,0,0" Opacity="0"/>
                    <TextBlock x:Name="WelcomeLine" FontSize="19" Foreground="#B3E6F2FF" Margin="0,6,0,0" Opacity="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- hidden Spotify Web Playback device (only started after you connect Spotify) -->
        <wv2:WebView2 x:Name="Web" Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
    </Grid>
</Window>
